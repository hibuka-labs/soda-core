<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hibuka.soda</groupId>
        <artifactId>soda-core-parent</artifactId>
        <version>17.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>soda-event-redis</artifactId>
    <packaging>jar</packaging>

    <name>soda-event-redis</name>
    <description>Redis event bus extension for soda-core</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Core dependency -->
        <dependency>
            <groupId>com.hibuka.soda</groupId>
            <artifactId>soda-core-base</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Redis dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        
        <!-- Spring Boot test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
        </plugins>
    </build>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Scoda Team</name>
            <email>chenkangzeng@163.com</email>
            <organization>Scoda</organization>
            <organizationUrl>https://github.com/chenkangzeng1</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/chenkangzeng1/soda-core.git</connection>
        <developerConnection>scm:git:git@github.com:chenkangzeng1/soda-core.git</developerConnection>
        <url>https://github.com/chenkangzeng1/soda-core</url>
    </scm>
</project>